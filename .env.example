DATABASE_URL="file:./dev.db"

# Long random string used to sign auth session tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""

# Seeded on first startup only - change ADMIN_PASSWORD via a real admin UI afterwards, not by editing this file
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Optional - ticket notification emails are skipped if these aren't set
SMTP_HOST=""
SMTP_PORT="465"
EMAIL_USER=""
EMAIL_PASS=""
